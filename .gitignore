# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/

# Gradle files
.gradle/

# Local configuration file (sdk path, etc)
local.properties

# Log Files
*.log

# What a failing emulator run leaves behind for the CI artifact
emulator-diagnostics/

# Android Studio navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/caches/build_file_checksums.ser

# Signing keys — never commit these
*.jks
*.keystore
keystore.properties

# Stored git credentials
# The credential helper used in this checkout writes a token beside the tree
# (`.git-credentials.local`). Matched by pattern so a different suffix cannot
# slip in, and separate from the signing-key rules above: these are passwords.
.git-credentials*
*.credentials

# Native build output
.externalNativeBuild
.cxx/

# Firebase config (contains project API keys)
google-services.json

# Kotlin
.kotlin/

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Profiler
*.hprof

# OS files
.DS_Store
Thumbs.db

# Freebuff local workspace state
.freebuff/
