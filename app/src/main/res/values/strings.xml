    <string name="direct_connect">Join</string>
    <string name="direct_none_found">No group owner found yet. The receiving phone has to open its group first.</string>
    <string name="direct_unsupported">This phone cannot do Wi-Fi Direct. Use the address above instead.</string>
    <string name="direct_no_permission">Android needs the Nearby devices permission for Wi-Fi Direct. Allow it and tap again.</string>
    <string name="direct_granted">Permission granted — tap again to connect.</string>
    <string name="direct_error">Wi-Fi Direct refused the request (code %1$d). Check that Wi-Fi Direct is on and that no other group is open.</string>
    <string name="direct_port_note">Wi-Fi Direct sends to the default port; if the receiving phone had to use another one, type the address it shows.</string>
