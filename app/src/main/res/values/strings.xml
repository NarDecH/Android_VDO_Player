    <string name="direct_receive_title">No router? Wi-Fi Direct</string>
    <string name="direct_receive_body">Open a group on this phone and the other one can join it directly, even when there is no Wi-Fi network in range. The address below is the one a sender uses.</string>
    <string name="direct_open_group">Open the Wi-Fi Direct group</string>
    <string name="direct_close_group">Close the group</string>
    <string name="direct_group_open">Group is open — a sender reaches this phone at %1$s</string>
    <string name="direct_send_title">Join a phone that has no router</string>
    <string name="direct_send_body">Look for a receiving phone that opened a Wi-Fi Direct group and join it. It then shows up in the receiver list above, where you type the code.</string>
    <string name="direct_scan">Find Wi-Fi Direct phones</string>
    <string name="direct_scan_stop">Stop looking</string>
