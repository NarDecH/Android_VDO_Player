    <string name="transfer_state_failed">Failed</string>
    <string name="transfer_state_cancelled">Cancelled</string>
    <string name="transfer_progress">%1$s / %2$s</string>
    <string name="transfer_need_target">Pick a phone or type an address first.</string>
    <string name="transfer_need_code">Enter the four digit code shown on the receiving phone first.</string>
    <string name="transfer_permission_title">Allow local network access</string>
    <string name="transfer_permission_body">Android 17 keeps every app off the local network until you allow it. Without this, the other phone cannot find this one and files will not leave or arrive. It covers your own Wi-Fi only — nothing is sent to the internet.</string>
    <string name="transfer_permission_grant">Allow</string>
    <string name="transfer_permission_denied">Local network access is blocked, so transfers cannot run. Allow it in Settings → Apps → VDO Player → Permissions → Nearby devices.</string>
    <string name="transfer_privacy_note">Files travel inside your own Wi-Fi network only: the app is a local server and client, it never uploads anything anywhere. Videos land in Movies/VDO Player and show up in the library; other files land in Download/VDO Player.</string>

